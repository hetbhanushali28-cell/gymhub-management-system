# ========================================================
# GymHub Server Environment Variables (Render / Local)
# ========================================================
PORT=5000
NODE_ENV=production

# Local MongoDB (when running natively or in Docker):
# MONGO_URI=mongodb://localhost:27017/gym-management
#
# Production Cloud MongoDB Atlas (Free Tier cluster):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gym-management?retryWrites=true&w=majority

# JWT Auth Secret:
JWT_SECRET=gym_super_secret_jwt_key_2026_het_bhanushali
JWT_EXPIRES_IN=30d

# Frontend URL (For Production CORS & Socket.IO WebSockets):
# Replace with your deployed Vercel domain:
CLIENT_URL=https://gymhub-frontend.vercel.app

