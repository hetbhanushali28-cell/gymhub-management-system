{
  "info": {
    "_postman_id": "gymhub-mern-mini-project-evaluation",
    "name": "GymHub MERN API Collection (College Evaluation)",
    "description": "Complete REST API collection for GymHub Gym Management System with JWT Authentication, Role-Based Access Control, express-validator schemas, and Mongoose Compound Indexes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "memberToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "classId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Member Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('memberToken', jsonData.token);",
                  "    console.log('Member token saved:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.2 Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    console.log('Admin token saved:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gymhub.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.3 Register New User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "1.4 Get Profile (Protected with JWT)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "1.5 Update Profile & Emergency Contacts",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"+1 (555) 234-8901\",\n  \"emergencyContact\": {\n    \"name\": \"Sarah Connor\",\n    \"phone\": \"+1 (555) 987-6543\",\n    \"relation\": \"Spouse\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "1.6 Renew Membership Subscription",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tier\": \"VIP Elite\",\n  \"additionalDays\": 365\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/renew", "host": ["{{baseUrl}}"], "path": ["auth", "renew"] }
          }
        }
      ]
    },
    {
      "name": "2. Classes",
      "item": [
        {
          "name": "2.1 Get All Classes (Computed availableSlots)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.length > 0) {",
                  "    pm.collectionVariables.set('classId', jsonData[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] }
          }
        },
        {
          "name": "2.2 Get Single Class by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/classes/{{classId}}", "host": ["{{baseUrl}}"], "path": ["classes", "{{classId}}"] }
          }
        },
        {
          "name": "2.3 Create Class (Admin Protected + Validated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Functional Core Workout\",\n  \"description\": \"Intense 45-minute abs and stabilization session.\",\n  \"instructor\": \"David Goggins\",\n  \"date\": \"2026-11-25\",\n  \"time\": \"19:00\",\n  \"duration\": 45,\n  \"capacity\": 15,\n  \"category\": \"HIIT\",\n  \"difficulty\": \"Advanced\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] }
          }
        },
        {
          "name": "2.4 Delete Class (Admin Protected + Cascade)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/classes/{{classId}}", "host": ["{{baseUrl}}"], "path": ["classes", "{{classId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Bookings",
      "item": [
        {
          "name": "3.1 Create Booking (User Protected + Compound Index)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"{{classId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "3.2 Get My Bookings (Member)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.length > 0) {",
                  "    pm.collectionVariables.set('bookingId', jsonData[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings/my", "host": ["{{baseUrl}}"], "path": ["bookings", "my"] }
          }
        },
        {
          "name": "3.3 Get All Bookings (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "3.4 Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Data Validation Tests (For Teacher Demo)",
      "item": [
        {
          "name": "4.1 Test Registration Validation (Rejects short pass/bad email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "4.2 Test Class Validation (Rejects bad date/zero capacity)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hi\",\n  \"description\": \"Bad\",\n  \"instructor\": \"X\",\n  \"date\": \"bad-date\",\n  \"time\": \"25:99\",\n  \"duration\": 2,\n  \"capacity\": 0,\n  \"category\": \"NonExistent\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] }
          }
        },
        {
          "name": "4.3 Test Route Protection (Expects 401 without Token)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "4.4 Test Role Guard (Expects 403 when Member visits Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        }
      ]
    },
    {
      "name": "5. Membership Tiers & Plans",
      "item": [
        {
          "name": "5.1 Get All Tiers (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tiers", "host": ["{{baseUrl}}"], "path": ["tiers"] }
          }
        },
        {
          "name": "5.2 Create Membership Tier (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Executive Quarterly\",\n  \"price\": 1200,\n  \"billingPeriod\": \"quarter\",\n  \"description\": \"Quarterly premium pass with private recovery access\",\n  \"features\": [\"24/7 Access\", \"Sauna & Plunge\", \"10 Group Classes\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/tiers", "host": ["{{baseUrl}}"], "path": ["tiers"] }
          }
        },
        {
          "name": "5.3 Toggle Tier Status (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/tiers/6af60bad97ab7e530aeca125", "host": ["{{baseUrl}}"], "path": ["tiers", "6af60bad97ab7e530aeca125"] }
          }
        }
      ]
    }
  ]
}

